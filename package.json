{
  "name": "wafflelog-v2",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --clean",
    "eas:ios:preview": "eas build --platform ios --profile preview",
    "eas:android:preview": "eas build --platform android --profile preview",
    "lint": "expo lint",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run unit.test",
    "test:integration": "vitest run integration.test",
    "supabase:prepare": "set -a && . ./supabase/.env && set +a && npx supabase stop && npx supabase start && npx supabase db reset --local",
    "supabase:serve": "npx supabase functions serve",
    "test:service": "npm run supabase:prepare && set -a && . ./supabase/.env && set +a && vitest run service.test",
    "test:service:fast": "set -a && . ./supabase/.env && set +a && vitest run service.test",
    "test:watch": "vitest",
    "sb:gen": "supabase gen types typescript --project-id shscucanawhrjahqokvn --schema public > ./lib/supabase/types.ts",
    "api:types": "openapi-typescript https://api.wafflelog.co.uk/openapi.json -o ./lib/ai-trip-planning/generated.ts"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.0",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "expo": "^57.0.9",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "supabase": "^2.92.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
