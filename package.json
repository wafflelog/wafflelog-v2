{
  "name": "wafflelog-v2",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --clean",
    "eas:ios:preview": "eas build --platform ios --profile preview",
    "eas:android:preview": "eas build --platform android --profile preview",
    "lint": "expo lint",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run unit.test",
    "test:integration": "vitest run integration.test",
    "supabase:prepare": "set -a && . ./supabase/.env && set +a && npx supabase stop && npx supabase start && npx supabase db reset --local",
    "test:service": "npm run supabase:prepare && set -a && . ./supabase/.env && set +a && vitest run service.test",
    "test:service:fast": "set -a && . ./supabase/.env && set +a && vitest run service.test",
    "test:watch": "vitest",
    "sb:gen": "supabase gen types typescript --project-id shscucanawhrjahqokvn --schema public > ./lib/supabase/types.ts"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.6.0",
